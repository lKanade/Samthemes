<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:label="SamThemes"
        android:supportsRtl="true">

        <!-- Identificadores oficiales de Hex Installer -->
        <meta-data android:name="project_hex" android:value="true" />
        <meta-data android:name="hex_plugin" android:value="true" />
        <meta-data android:name="hex_author" android:value="Kanade" />
        <meta-data android:name="hex_theme_name" android:value="SamThemes" />
        <meta-data android:name="hex_description" android:value="Plugin S24 Ultra" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FloatingWindowService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
